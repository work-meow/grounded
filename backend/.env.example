# Copy to backend/.env. Every field of app/config.py is settable here by its
# own name in upper case — this file carries the ones you must set plus the
# ones worth knowing about. The rest have defaults that are right for a
# personal install.

# --- required ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
# openssl rand -hex 32
JWT_SECRET=change-me-to-32-plus-random-characters-please
OPENROUTER_API_KEY=

# --- auth ----------------------------------------------------------------------
# false only when serving over plain http on a host that is not localhost;
# otherwise the browser refuses the session cookie.
COOKIE_SECURE=true

# --- object storage (originals) ------------------------------------------------
S3_BUCKET=rag
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Empty for AWS; set for MinIO / Cloudflare R2 / Backblaze.
# S3_ENDPOINT_URL=http://localhost:9000
# MinIO and most self-hosted gateways need bucket-in-path addressing.
# S3_PATH_STYLE=true
# Where the *browser* reaches the same bucket. Presigned links are signed for
# this host, so behind a reverse proxy it differs from S3_ENDPOINT_URL.
# S3_PUBLIC_URL=https://s3.example.com
# MAX_UPLOAD_BYTES=67108864
# Ceiling on a wedged object store, per attempt (три попытки).
# S3_TIMEOUT_S=60

# --- connected sources ---------------------------------------------------------
# Seals a connector's credentials before they reach the database or the bucket.
# The indexer needs the identical value to open them again. Leave empty and
# connecting a source is disabled rather than done insecurely.
#   python -c "from rag_shared.crypto import generate_key; print(generate_key())"
SECRETS_KEY=
# Shown in the UI so a user knows whom to share a Drive folder with. The key
# itself lives in the indexer, which is the only process that reads Drive.
# GDRIVE_SERVICE_ACCOUNT_EMAIL=rag-indexer@your-project.iam.gserviceaccount.com

# --- indexer -------------------------------------------------------------------
PATHWAY_URL=http://localhost:8666
# How many chunks one search returns to the agent.
RETRIEVE_K=8

# --- agent ---------------------------------------------------------------------
AGENT_MODEL=openai/gpt-5-mini
# Сколько модели позволено рассуждать до ответа. Замерено: на "minimal" она и
# точнее, и вдвое быстрее — развёрнутое рассуждение отговаривало её от того,
# что вернул поиск. Пустая строка — для модели, которая параметр не принимает.
AGENT_REASONING_EFFORT=minimal
# Сколько ждать провайдера, прежде чем признать запрос неудачным.
# AGENT_TIMEOUT_S=120
# Потолки, чтобы запутавшийся агент не унёс счёт. Первые два — то, что делает
# безопасным указание «поищи ещё раз другой формулировкой».
MAX_KNOWLEDGE_SEARCHES_PER_RUN=3
MAX_WEB_SEARCHES_PER_RUN=2
MAX_TOOL_CALLS_PER_RUN=6
MAX_MODEL_CALLS_PER_RUN=8

# Сколько долларов один токен может потратить за сутки (UTC), 0 — без потолка.
# Выключено по умолчанию: у личной установки один вызывающий, и лимит, о котором
# не просили, — это лимит, который однажды удивит. Ставить стоит в тот момент,
# когда токен отдан чему-то ещё: досрочно он не истекает, поэтому утёкший может
# тратить в цикле.
# DAILY_COST_LIMIT_USD=1.00

# --- спросить индекс несколькими формулировками ---------------------------------
# Первый поиск хода — это вопрос дословно. Агенту уже велено переформулировать
# после неудачного поиска, но узнаётся это ценой лишнего запроса и вызова судьи.
# Здесь формулировки создаются заранее и выдачи сливаются через RRF: BM25 и
# эмбеддинги промахиваются на разных словах, и судья должен выбирать из
# объединения.
#
# Выключено, и это измеренное решение, а не осторожность: на 35 живых вопросах
# полнота и точность не сдвинулись (10/23 и 23 фрагмента по делу в обоих
# прогонах), а самый долгий ответ вырос с 14.3 до 16.8 с. На 26 документах
# ранжировать почти нечего. На корпусе в тысячи документов вопрос стоит задать
# заново — прибор для этого теперь есть.
# EXPAND_QUERIES=true
# EXPAND_TO=2

# --- отбор релевантного --------------------------------------------------------
# Индекс отвечает своими k лучшими фрагментами на любой запрос, подходящие они
# или нет. Второй проход читает кандидатов и говорит, какие относятся к вопросу.
# Замерено на 13 вопросах: по делу было 24% фрагментов, стало 82%, а на вопросах
# без ответа возвращается ноль вместо восьми. 0.3–0.7 с и ~$0.00017 за вызов.
RERANK_ENABLED=true
RERANK_MODEL=google/gemini-2.5-flash-lite
RERANK_CANDIDATES=20
RERANK_KEEP=6
# Сколько фрагментов одного документа показывать на странице поиска. Только для
# просмотра: ответу на вопрос про длинный документ его фрагменты нужны все.
MAX_CHUNKS_PER_DOCUMENT=2

# --- поиск в сети (включается пользователем на конкретное сообщение) ------------
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ищет отдельная модель подешевле и пересказывает найденное; ответ пишет агент.
WEB_SEARCH_MODEL=google/gemini-2.5-flash-lite
# Движок поиска на стороне OpenRouter. Замерено: parallel/turbo — $0.00125 за
# вызов и 2.2 с, exa — $0.0072 и 3.3 с при меньшем объёме текста на источник.
# Нативного поиска у Gemini на OpenRouter нет вовсе.
WEB_SEARCH_ENGINE=parallel
WEB_SEARCH_RESULTS=6
# WEB_SEARCH_TIMEOUT_S=30
# How many past messages are replayed into each turn.
HISTORY_WINDOW=20
# Чей «сегодня». Модель не знает текущей даты, а половина вопросов к личной базе
# без неё бессмысленна («что на этой неделе», «сколько осталось до сдачи»),
# поэтому дата подставляется в промпт на каждом ходу — вот в этой зоне.
TIMEZONE=Europe/Moscow

# --- http ----------------------------------------------------------------------
# Only used when the UI is served from another origin. In the deployed setup
# Traefik puts /api and / on one host, so CORS never comes into play.
CORS_ORIGINS=["http://localhost:3000"]
