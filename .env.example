# Deployment environment for docker-compose.yml.
# Copy to .env on the host and fill in. Never commit the filled-in copy.

# --- hostnames ----------------------------------------------------------------
# sslip.io resolves <anything>-<dashed-ip>.sslip.io to that IP, so no DNS record
# is needed. Swap both for real names once you have them.
APP_DOMAIN=rag-144-31-191-29.sslip.io
S3_DOMAIN=rag-s3-144-31-191-29.sslip.io
S3_PUBLIC_URL=https://rag-s3-144-31-191-29.sslip.io

# --- application database -----------------------------------------------------
# The host's existing PostgreSQL, reachable by service name on dokploy-network.
DATABASE_URL=postgresql+asyncpg://rag:CHANGE_ME@postgres1-hajnvy:5432/rag

# --- auth ---------------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# --- object storage -----------------------------------------------------------
S3_BUCKET=rag
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rag
S3_SECRET_ACCESS_KEY=CHANGE_ME

# --- models -------------------------------------------------------------------
OPENROUTER_API_KEY=CHANGE_ME
# Cheap and good enough for a personal knowledge base.
AGENT_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=openai/text-embedding-3-small
