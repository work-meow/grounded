# --- application database ---------------------------------------------------
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# --- auth --------------------------------------------------------------------
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-32-plus-random-characters-please
# Set to false only when serving the UI over plain http on localhost.
COOKIE_SECURE=true

# --- object storage (originals) ----------------------------------------------
S3_BUCKET=rag
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave empty for AWS; set for MinIO / Cloudflare R2 / Backblaze.
# S3_ENDPOINT_URL=http://localhost:9000

# --- indexer ------------------------------------------------------------------
PATHWAY_URL=http://localhost:8666
RETRIEVE_K=8

# --- agent --------------------------------------------------------------------
OPENROUTER_API_KEY=
AGENT_MODEL=anthropic/claude-sonnet-4-5
MAX_TOOL_CALLS_PER_RUN=5

# --- http ---------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
