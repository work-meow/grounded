# Deployment environment for docker-compose.yml.
# Copy to .env on the host and fill in. Never commit the filled-in copy.

# --- hostnames ----------------------------------------------------------------
# sslip.io resolves <anything>-<dashed-ip>.sslip.io to that IP, so nothing has
# to be registered anywhere: for 203.0.113.10 write rag-203-0-113-10.sslip.io.
# Swap both for real names once you have them.
# The bucket needs its own host because presigned links are opened by the
# browser and the signature covers the hostname.
APP_DOMAIN=rag-<your-dashed-ip>.sslip.io
S3_DOMAIN=rag-s3-<your-dashed-ip>.sslip.io
S3_PUBLIC_URL=https://rag-s3-<your-dashed-ip>.sslip.io

# --- application database -----------------------------------------------------
# The host's existing PostgreSQL, reachable by service name on dokploy-network.
DATABASE_URL=postgresql+asyncpg://rag:CHANGE_ME@<postgres-container>:5432/rag

# --- auth ---------------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# --- object storage -----------------------------------------------------------
S3_BUCKET=rag
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rag
S3_SECRET_ACCESS_KEY=CHANGE_ME

# --- connected sources --------------------------------------------------------
# Seals a connector's credentials wherever they come to rest — the sources table
# and the manifest in the bucket. Both the API and the indexer need this exact
# value: one seals, the other opens. Empty disables connecting sources.
#   docker compose run --rm backend python -c \
#     "from rag_shared.crypto import generate_key; print(generate_key())"
SECRETS_KEY=CHANGE_ME
# Google Drive, if you want it. Create a service account in Google Cloud, enable
# the Drive API, download its key, and paste the JSON here on ONE line. Users
# then share a folder with the address below; the account can read nothing else.
# GDRIVE_CREDENTIALS_JSON={"type":"service_account",...}
# GDRIVE_SERVICE_ACCOUNT_EMAIL=rag-indexer@your-project.iam.gserviceaccount.com
# How often every connected source is re-read, in seconds.
REFRESH_INTERVAL_S=600

# --- models -------------------------------------------------------------------
OPENROUTER_API_KEY=CHANGE_ME
# $0.25 per million tokens in, $2 out, and 400k of context.
AGENT_MODEL=openai/gpt-5-mini
# Замерено на девяти вопросах, ответы на которые лежали в найденных фрагментах:
# по умолчанию модель отвечала верно 7 раз из 9 за 9.3 с, на "minimal" — 9 из 9
# за 4.7 с. Больше рассуждения давало меньше точности.
AGENT_REASONING_EFFORT=minimal
# $0.02 per million tokens. Changing this invalidates the whole index: a
# different model is a different vector space, so everything is re-embedded.
EMBEDDING_MODEL=openai/text-embedding-3-small
