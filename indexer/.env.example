# Copy to indexer/.env. Every field of rag_indexer/config.py is settable here by
# its own name in upper case.
#
# Its inputs are the bucket the API writes to, plus whatever connected sources
# the manifest in that bucket names.

# --- object storage (uploads, and the connector manifest) ----------------------
S3_BUCKET=rag
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Empty for AWS; set for MinIO / Cloudflare R2 / Backblaze.
# S3_ENDPOINT_URL=http://localhost:9000
# MinIO and most self-hosted gateways need bucket-in-path addressing.
# S3_PATH_STYLE=true

# --- connected sources ---------------------------------------------------------
# Opens the credentials the API sealed. The identical value as the API's.
# Leave empty and only uploads are indexed.
SECRETS_KEY=
# The Google service account key, as JSON on one line. Users share a Drive
# folder with this account's address; it can read nothing else.
# GDRIVE_CREDENTIALS_JSON={"type":"service_account",...}
# How often a connected source is re-read, in seconds.
REFRESH_INTERVAL_S=600
# How often the manifest is checked for a change — the delay between adding a
# source in the UI and the index restarting to include it.
# MANIFEST_POLL_S=30
# A ceiling on one document, matching the API's upload limit.
# MAX_DOCUMENT_BYTES=67108864

# --- embeddings ----------------------------------------------------------------
# Through OpenRouter's OpenAI-compatible endpoint — the embedding compute is
# theirs, not this box's.
OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- chunking ------------------------------------------------------------------
# Tokens, not characters (the splitter is given a tiktoken encoding).
CHUNK_SIZE=500
CHUNK_OVERLAP=60

# Ставит перед каждым чанком одну фразу о том, частью чего он является: чанк из
# середины политики, где написано только «28 календарных дней», иначе не знает,
# что он про отпуск. Фраза попадает и в вектор, и в BM25.
#
# Замерено на 35 живых вопросах, одна переменная: необоснованных утверждений в
# ответах стало 11 вместо 25, полностью обоснованных ответов — 12 из 15 вместо
# 10, полнота и скорость не изменились.
#
# Рекомендуется — и всё равно выключено по умолчанию: включение меняет то, что
# индексируется, поэтому существующая установка переэмбеддит корпус при
# следующем старте (как при смене CHUNK_SIZE или модели эмбеддингов).
# Включайте вместе со свежим CACHE_DIR, чтобы прежний остался для отката.
# CONTEXTUAL_CHUNKS=true
# CONTEXT_MODEL=google/gemini-2.5-flash-lite
# CONTEXT_BATCH=8
# CONTEXT_CONCURRENCY=4
# CONTEXT_MAX_CHUNKS=40

# --- server --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8666
LOG_LEVEL=INFO
# Embeddings are cached here, so a restart does not re-pay for every chunk.
CACHE_DIR=./Cache
