# The indexer reads the same bucket the API writes to, and nothing else.
S3_BUCKET=rag
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave empty for AWS; set for MinIO / Cloudflare R2 / Backblaze.
# S3_ENDPOINT_URL=http://localhost:9000
# MinIO and most self-hosted gateways need this.
# S3_PATH_STYLE=true

# Embeddings go through OpenRouter's OpenAI-compatible endpoint.
OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small

# Chunking
CHUNK_MIN_TOKENS=100
CHUNK_MAX_TOKENS=500

# Where the API reaches this process.
HOST=0.0.0.0
PORT=8666
CACHE_DIR=./Cache
